# Copia este fichero a .env y rellena los valores reales.
# .env NUNCA se sube al repositorio (está en .gitignore).

# === Django ===
# Genera una con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY='pon-aqui-tu-secret-key'
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# === Spotify ===
# Crea la app en https://developer.spotify.com/dashboard para obtener client id/secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con el Redirect URI registrado en el dashboard de Spotify.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Lo genera el script authorize_spotify.py (Bloque 2). Déjalo vacío al principio.
SPOTIFY_REFRESH_TOKEN=
